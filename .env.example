# Скопируйте в .env (make env) и при необходимости поменяйте значения
POSTGRES_USER=malscan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=malscan
POSTGRES_PORT=5432

# Строка подключения для backend (используется с этапа 6)
DATABASE_URL=postgresql+psycopg://malscan:change-me@localhost:5432/malscan

# Ограничения обработки файлов (разделы 3 и 4 ТЗ)
MAX_UPLOAD_MB=50
PARSE_TIMEOUT_SECONDS=60
