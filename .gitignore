# Данные и артефакты не коммитим: они большие и воспроизводятся скриптами
# Игнорируем содержимое, но не сами папки (в них лежит .gitkeep)
data/raw/**/*
data/processed/*
data/splits/*
artifacts/models/*
!data/raw/**/
!**/.gitkeep

# Образцы и карантин никогда не попадают в git
quarantine/
*.bin

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Node
node_modules/
frontend/dist/

# Окружение
.env

# Безопасные тестовые PE-файлы (см. core/tests/fixtures/README.md)
!core/tests/fixtures/pe/**
